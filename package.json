{
  "name": "archipelago-timer-stat-tracker",
  "version": "0.5.1",
  "description": "Shared Archipelago run timers, individual and group completion statistics, and a solo stopwatch.",
  "main": "src/main.js",
  "author": "JC_DeSantis",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:ui": "electron test/timer-ui-smoke.cjs",
    "build": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.jcdesantis.archipelago-timer-stat-tracker",
    "productName": "Archipelago Timer and Stat Tracker",
    "directories": {
      "output": "dist"
    },
    "compression": "normal",
    "files": [
      "src/main.js",
      "src/global-hotkeys.js",
      "src/compact-stats.js",
      "src/race-review.js",
      "src/review-controls.js",
      "src/settings.js",
      "src/room-progress.js",
      "src/progress-sync.js",
      "src/run-timer.js",
      "src/run-timer-preload.js",
      "src/run-timer-renderer.js",
      "src/timer-alerts.js",
      "src/race-results.js",
      "src/race-notifications.js",
      "src/race-features.js",
      "src/race-library.js",
      "src/sound-library.js",
      "src/feature-service.js",
      "src/feature-controls.js",
      "src/run-timer.html",
      "src/run-timer.css",
      "assets/icon.png",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable",
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Archipelago-Timer-and-Stat-Tracker-Portable.exe"
    },
    "nsis": {
      "artifactName": "Archipelago-Timer-and-Stat-Tracker-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Archipelago Timer and Stat Tracker",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Archipelago-Timer-and-Stat-Tracker-${version}-${arch}.${ext}",
    "publish": null
  }
}
